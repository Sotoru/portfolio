---
import { Icon } from "astro-icon/components";
import type { Sezione } from "../data/personale";
import Carosello from "./Carosello.astro";
import Timeline from "./Timeline.astro";

interface Props {
  sezioni: Sezione[];
}
const { sezioni } = Astro.props;
---

{
  sezioni.map((sezione) =>
    sezione.titoli ? (
      <Carosello titolo={sezione.titolo} titoli={sezione.titoli} quadrate={sezione.quadrate} />
    ) : (
      <section class="flex flex-col gap-4">
        {sezioni.length > 1 && <h3 class="text-eyebrow border-b border-current/15 pb-3 opacity-80">{sezione.titolo}</h3>}
        {sezione.timeline && <Timeline voci={sezione.timeline} anniVuoti={sezione.anniVuoti} />}
        {sezione.voci.length > 0 && (
          <ul class="grid grid-cols-2 gap-3 md:grid-cols-4">
            {sezione.voci.map((voce) => (
              <li class="voce flex flex-col gap-3 rounded-(--card-radius) bg-current/7 p-4">
                <span class="flex size-11 items-center justify-center rounded-2xl bg-current/10">
                  <Icon name={voce.icona} aria-hidden="true" class="icona size-6" />
                </span>
                <span class="text-ui">{voce.cosa}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
    ),
  )
}

<style>
  /* Al passaggio l'icona si inclina appena, con la molla del sito; ferma se il movimento è ridotto. */
  .icona {
    transition: rotate var(--molla), scale var(--molla);
  }
  @media (hover: hover) and (pointer: fine) {
    .voce:hover .icona {
      rotate: -8deg;
      scale: 1.08;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .icona {
      transition: none;
    }
  }
</style>
