---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  progetto: CollectionEntry<"progetti">;
}
const { nome, interfaccia } = Astro.props.progetto.data;
const { desktop, mobile } = interfaccia;
---

<figure class="vetrina-schermi relative pb-[18%] md:pr-[16%] md:pb-[6%]">
  <Image
    src={desktop.immagine}
    alt={`${nome}: ${desktop.didascalia}`}
    widths={[640, 960, 1880]}
    sizes="(min-width: 1440px) 1000px, 86vw"
    class="schermo-desktop attenua block h-auto w-[92%] rounded-(--media-radius) md:w-full"
  />
  <Image
    src={mobile.immagine}
    alt={`${nome}: ${mobile.didascalia}`}
    widths={[240, 480]}
    sizes="(min-width: 768px) 260px, 34vw"
    class="schermo-mobile attenua absolute right-[2%] bottom-0 w-[26%] object-cover object-top md:right-0 md:w-[22%]"
  />
  <figcaption class="sr-only">{desktop.didascalia} e {mobile.didascalia}</figcaption>
</figure>

<style>
  /*
   * Ombra solo sotto, quasi niente ai lati e niente sopra: quando la riga fissa passa sopra le immagini
   * la taglierebbe con un bordo netto, e il blu accanto sembrerebbe di due toni diversi.
   * Tinta col colore del progetto scurito, così si fonde con lo sfondo invece di ingrigirlo.
   */
  .vetrina-schermi img {
    box-shadow:
      0 32px 40px -28px color-mix(in srgb, var(--primary), black 55%),
      0 10px 16px -10px color-mix(in srgb, var(--primary), black 40%);
  }
  /*
   * Proporzioni di un telefono vero (390 × 844) invece dell'intero screenshot, che è lungo quasi tre schermi.
   * Raggio in proporzione alla larghezza (11%, cioè 11% / 5.08% sui due assi): a 1440 px vale circa 29 px, come il desktop accanto;
   * su mobile, dove il telefono è largo 80 px, scende a 9 px invece di diventare una pillola.
   */
  /* Inclinato al contrario del telefono: i due schermi si aprono a ventaglio. */
  .schermo-desktop {
    rotate: -2deg;
  }
  .schermo-mobile {
    aspect-ratio: 390 / 844;
    border-radius: 11% / 5.08%;
    outline: 1px solid rgb(255 255 255 / 0.12);
    outline-offset: -1px;
    rotate: 4deg;
  }
  /* Il telefono sta sopra: ombra più ampia del desktop. */
  .vetrina-schermi .schermo-mobile {
    box-shadow:
      0 40px 56px -32px color-mix(in srgb, var(--primary), black 60%),
      0 14px 22px -12px color-mix(in srgb, var(--primary), black 45%);
  }

  /*
   * Allo scroll i due schermi salgono e si raddrizzano verso l'inclinazione finale: legato alla posizione della sezione, non al tempo.
   * Il desktop si muove di meno, così il telefono gli scorre sopra.
   */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .schermo-mobile {
        animation: sale linear both;
      }
      .schermo-desktop {
        animation: sale-desktop linear both;
      }
      .vetrina-schermi .schermo-mobile,
      .vetrina-schermi .schermo-desktop {
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
      @keyframes sale {
        from {
          translate: 0 48px;
          rotate: 8deg;
        }
      }
      @keyframes sale-desktop {
        from {
          translate: 0 24px;
          rotate: -4deg;
        }
      }
    }
  }
</style>
