---
import { Icon } from "astro-icon/components";

import { i18n } from "../i18n";
const { t } = i18n(Astro.params);
const scelte = [
  { valore: "chiaro", nome: t("temaChiaro"), icona: "ph:sun" },
  { valore: "sistema", nome: t("temaSistema"), icona: "ph:monitor" },
  { valore: "scuro", nome: t("temaScuro"), icona: "ph:moon" },
];
---

<!--
  A riposo mostra solo il tema attivo; al clic si apre con le tre scelte e si richiude dopo la scelta,
  con Esc o uscendo dal gruppo. Resta un radiogroup: le frecce lo aprono e cambiano tema come i radio nativi.
-->
<div
  role="radiogroup"
  aria-label={t("tema")}
  class="selettore-tema flex shrink-0 items-center rounded-full border border-brand-surface p-0.5 text-brand-ink"
>
  {
    scelte.map((s) => (
      <button
        type="button"
        role="radio"
        data-tema={s.valore}
        aria-checked={s.valore === "sistema" ? "true" : "false"}
        aria-label={s.nome}
        title={s.nome}
        class="voce flex size-8 items-center justify-center overflow-hidden rounded-full text-brand-ink/60 hover:text-brand-ink aria-checked:bg-brand-surface aria-checked:text-brand-ink"
      >
        <Icon name={s.icona} aria-hidden="true" class="size-[18px] shrink-0" />
      </button>
    ))
  }
</div>

<style>
  .voce {
    transition:
      width var(--molla),
      opacity 200ms ease-out,
      visibility 200ms,
      background-color 200ms ease-out,
      color 200ms ease-out;
  }
  .selettore-tema:not([data-aperto]) .voce:not([aria-checked="true"]) {
    width: 0;
    opacity: 0;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .voce {
      transition: none;
    }
  }
</style>

<script>
  const gruppo = document.querySelector<HTMLElement>(".selettore-tema")!;
  const voci = [...gruppo.querySelectorAll<HTMLButtonElement>("[role=radio]")];
  const radice = document.documentElement;

  const apri = (aperto: boolean) => gruppo.toggleAttribute("data-aperto", aperto);
  const mostra = (tema: string) => {
    voci.forEach((v) => {
      const attiva = v.dataset.tema === tema;
      v.setAttribute("aria-checked", String(attiva));
      v.tabIndex = attiva ? 0 : -1;
    });
  };
  const applica = (tema: string) => {
    if (tema === "sistema") {
      delete radice.dataset.tema;
      localStorage.removeItem("tema");
    } else {
      radice.dataset.tema = tema;
      localStorage.setItem("tema", tema);
    }
    mostra(tema);
  };

  mostra(radice.dataset.tema ?? "sistema");
  voci.forEach((v, i) => {
    v.addEventListener("click", () => {
      if (!gruppo.hasAttribute("data-aperto")) return apri(true);
      applica(v.dataset.tema!);
      apri(false);
    });
    v.addEventListener("keydown", (e) => {
      if (e.key === "Escape") return apri(false);
      const passo = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
      if (passo === undefined) return;
      e.preventDefault();
      apri(true);
      const prossima = voci[(i + passo + voci.length) % voci.length];
      applica(prossima.dataset.tema!);
      prossima.focus();
    });
  });
  gruppo.addEventListener("focusout", (e) => {
    if (!gruppo.contains(e.relatedTarget as Node | null)) apri(false);
  });
  document.addEventListener("pointerdown", (e) => {
    if (!gruppo.contains(e.target as Node)) apri(false);
  });
</script>
