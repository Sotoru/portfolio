---
interface Props {
  testo: string;
  sopra: string;
  sotto: string;
  class?: string;
}
const { testo, sopra, sotto, class: cls } = Astro.props;
---

<!--
  Due copie nella stessa identica posizione, ritagliate sulla linea della superficie: sopra il colore del titolo,
  sotto il "negativo". Il taglio è geometrico, quindi resta a filo con qualsiasi font e metrica.
  La linea cade a 0.85em dall'alto (base di Poppins con line-height 1); la copia sopra sborda di 1px per evitare un filo d'antialiasing.
  Il letter-spacing negativo fa sporgere l'ultima lettera dal riquadro: i ritagli lasciano margine ai lati.
-->
<span class:list={["lettering absolute z-10 block h-0", cls]} style={`--sopra:${sopra};--sotto:${sotto}`}>
  <span class="absolute bottom-[-0.15em] left-0 text-(--sopra) [clip-path:inset(-0.2em_-0.2em_calc(0.15em_-_1px)_-0.2em)]">{testo}</span>
  <span class="absolute bottom-[-0.15em] left-0 text-(--sotto) [clip-path:inset(0.85em_-0.2em_-0.2em_-0.2em)]" aria-hidden="true">{testo}</span>
</span>
