---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import { i18n, indirizzo, lingueEstere } from "../../i18n";

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, ...lingueEstere.map((lang) => ({ params: { lang } }))];
}

const { l, t } = i18n(Astro.params);
---

<!-- La mostra il service worker quando una pagina mai visitata non si può scaricare. -->
<Layout title={`${t("offlineTitolo")} · Paolo Laddomada`} description={t("offlineTesto")} pagina="offline/" noindex>
  <main class="mx-auto flex min-h-[70svh] max-w-[560px] flex-col items-center justify-center gap-6 px-(--page-x) pt-(--page-top) text-center text-brand-ink">
    <span class="flex size-16 items-center justify-center rounded-3xl bg-brand-surface">
      <Icon name="ph:wifi-slash" aria-hidden="true" class="size-8" />
    </span>
    <h1 class="text-h2">{t("offlineTitolo")}</h1>
    <p class="text-body opacity-85">{t("offlineTesto")}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <button type="button" onclick="location.reload()" class="text-ui flex h-12 items-center gap-2 rounded-2xl bg-brand px-6 text-on-brand hover:brightness-110">
        <Icon name="ph:arrow-clockwise" aria-hidden="true" class="size-5" />
        {t("riprova")}
      </button>
      <a href={indirizzo(l)} class="text-ui flex h-12 items-center gap-2 rounded-2xl bg-brand-surface px-6 hover:brightness-95">
        {t("tornaHome")}
      </a>
    </div>
  </main>
</Layout>
