---
import { getCollection, type CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import Lettering from "../../components/Lettering.astro";
import VetrinaComponenti from "../../components/VetrinaComponenti.astro";
import SchermiSovrapposti from "../../components/SchermiSovrapposti.astro";
import Superficie from "../../components/Superficie.astro";
import IndiceSezioni from "../../components/IndiceSezioni.astro";
import SezioneLinguaggio from "../../components/SezioneLinguaggio.astro";
import { storybookPubblico } from "../../lib/storybook";
import { i18n, indirizzo, lingueEstere, tr } from "../../i18n";

export async function getStaticPaths() {
  const progetti = (await getCollection("progetti")).sort((a, b) => a.data.ordine - b.data.ordine);
  return [undefined, ...lingueEstere].flatMap((lang) =>
    progetti.map((progetto, i) => ({
      params: { lang, slug: progetto.id },
      props: { progetto, prossimo: progetti[(i + 1) % progetti.length] },
    })),
  );
}

interface Props {
  progetto: CollectionEntry<"progetti">;
  prossimo: CollectionEntry<"progetti">;
}
const { progetto, prossimo } = Astro.props;
const { id, data } = progetto;
const c = data.colori;
const pubblico = await storybookPubblico(data.storybook);
const { l, t } = i18n(Astro.params);
const home = indirizzo(l, `#${id}`);

const sezioni = [
  { id: "panoramica", nome: t("panoramica"), titolo: tr(data.panoramica.titolo, l) },
  { id: "interfaccia", nome: t("interfaccia"), titolo: t("titoloInterfaccia") },
  { id: "linguaggio", nome: t("linguaggio"), titolo: t("titoloLinguaggio") },
  { id: "componenti", nome: t("componenti"), titolo: t("titoloComponenti") },
] as const;

const risorse = [
  ...(pubblico ? [{ nome: "Storybook", href: data.storybook }] : []),
  { nome: "Design.md", href: data.design },
  { nome: "Repository", href: data.repository },
];

// Se il progetto ha una palette scura propria, in dark si usa quella (light-dark() sceglie in base a color-scheme).
const s = data.coloriScuri ?? c;
const tono = (chiaro: string, scuro: string) => (chiaro === scuro ? chiaro : `light-dark(${chiaro}, ${scuro})`);
const tema = [
  `--primary:${tono(c.primary, s.primary)}`,
  `--on-primary:${tono(c.onPrimary, s.onPrimary)}`,
  `--secondary:${tono(c.secondary, s.secondary)}`,
  `--on-secondary:${tono(c.onSecondary, s.onSecondary)}`,
  `--ink:${tono(c.textPrimary, s.textPrimary)}`,
  `--muted:${tono(c.textMuted, s.textMuted)}`,
  `--paper:${tono(c.canvas, s.canvas)}`,
  `--focus:${tono(c.onPrimary, s.onPrimary)}`,
  `--fondo:var(--color-canvas)`,
  `--accento-scuro:${data.coloriScuri?.accento ?? s.onPrimary}`,
  `--attivo:${tono(c.secondary, data.coloriScuri?.attivo ?? s.secondary)}`,
  `--on-attivo:${tono(c.onSecondary, data.coloriScuri?.onAttivo ?? s.onSecondary)}`,
].join(";");
const colonna = "mx-auto w-[min(var(--content-max),100%_-_2*var(--page-x))]";
---

<Layout title={`${data.nome} · Paolo Laddomada`} description={tr(data.descrizione, l)} fondo={tema} pagina={`${id}/`}>
  <main style={tema} class="pt-(--page-top)">
    <div class:list={[colonna, "relative h-(--display-box)"]}>
      <Lettering
        testo={tr(data.titolo, l)}
        sopra="var(--lettering, var(--primary))"
        sotto="var(--lettering-sotto, var(--color-canvas))"
        class="bottom-0 left-(--inner-x) text-(length:--display)"
      />
    </div>

    <div class="relative">
      <Superficie />

      <div class:list={[colonna, "relative text-on-primary"]}>
        <nav aria-label={t("navigazione")} class="testata flex items-center justify-between gap-4 px-(--inner-x) pt-(--section-y)">
          <a
            href={home}
            aria-label={t("tornaIndietro")}
            class="flex size-12 items-center justify-center rounded-2xl bg-secondary text-on-secondary hover:brightness-95 active:brightness-90"
          >
            <Icon name="ph:arrow-left" aria-hidden="true" class="size-5" />
          </a>
        </nav>

        <header data-reveal class="flex min-h-(--hero-h) flex-col items-center justify-center gap-6 px-(--inner-x) py-(--hero-y) text-center">
          {
            data.logoConNome ? (
              <h1 class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
                <img src={data.logo.src} width={data.logo.width} height={data.logo.height} alt="" class="size-(--ygo-mark)" />
                <span class="text-(length:--ygo-name) leading-(--ygo-name-lh) font-semibold tracking-[-0.035em]">{data.nome}</span>
              </h1>
            ) : (
              <h1>
                <img src={data.logo.src} width={data.logo.width} height={data.logo.height} alt={data.nome} class="h-auto w-(--pp-logo)" />
              </h1>
            )
          }
          <p class="text-body max-w-[680px]">{tr(data.descrizione, l)}</p>
          <a
            href={data.sito}
            class="text-ui flex h-12 w-[168px] items-center justify-center gap-1.5 rounded-2xl bg-secondary text-on-secondary hover:brightness-95 active:brightness-90"
          >
            {t("vaiAlSito")} <Icon name="ph:arrow-up-right" aria-hidden="true" class="size-4" />
          </a>
        </header>

        <IndiceSezioni sezioni={sezioni} indietro={home} testata=".testata" />

        {
          sezioni.map((s, i) => (
            <section
              data-reveal
              id={s.id}
              tabindex="-1"
              aria-labelledby={`${s.id}-titolo`}
              class:list={["flex scroll-mt-20 flex-col gap-6 px-(--inner-x) py-(--section-y) outline-none", { coda: i === sezioni.length - 1 }]}
            >
              <div class="flex flex-col gap-3">
                <p class="text-eyebrow">{s.nome}</p>
                <h2 id={`${s.id}-titolo`} class="text-h2">{s.titolo}</h2>
              </div>

              {s.id === "panoramica" && (
                <>
                  <p class="text-body max-w-[760px]">{tr(data.panoramica.testo, l)}</p>
                  <p class="text-ui">{data.panoramica.stack}</p>
                  <ul class="flex flex-wrap gap-2">
                    {risorse.map((r) => (
                      <li>
                        <a href={r.href} class="text-ui flex h-10 items-center gap-1.5 rounded-xl bg-white/8 px-4 hover:bg-white/14">
                          {r.nome} <Icon name="ph:arrow-up-right" aria-hidden="true" class="size-4" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </>
              )}

              {s.id === "interfaccia" && <SchermiSovrapposti progetto={progetto} />}

              {s.id === "linguaggio" && <SezioneLinguaggio progetto={progetto} pubblico={pubblico} />}

              {s.id === "componenti" && (
                <>
                  <p class="text-body">{t("introComponenti")}</p>
                  <VetrinaComponenti progetto={progetto} pubblico={pubblico} />
                </>
              )}

            </section>
          ))
        }
      </div>
    </div>

    <nav data-reveal aria-label={t("prossimo")} class:list={[colonna, "pt-(--page-gap)"]}>
      <a
        href={indirizzo(l, `${prossimo.id}/`)}
        style={`background:${tono(prossimo.data.colori.primary, (prossimo.data.coloriScuri ?? prossimo.data.colori).primary)};color:${tono(prossimo.data.colori.onPrimary, (prossimo.data.coloriScuri ?? prossimo.data.colori).onPrimary)}`}
        class="prossimo flex h-(--prossimo-h) flex-col justify-center gap-3 rounded-(--frame-radius) px-(--inner-x)"
      >
        <span class="text-eyebrow">{t("prossimo")}</span>
        <span class="text-h2 flex items-center gap-2">
          {tr(prossimo.data.titolo, l)}
          <Icon name="ph:arrow-right" aria-hidden="true" class="freccia size-[0.8em]" />
        </span>
        <span class="text-caption">{prossimo.data.home.prodotto}</span>
      </a>
    </nav>
  </main>
</Layout>

<style>
  main {
    --prossimo-h: 176px;
  }
  @media (min-width: 768px) {
    main {
      --prossimo-h: 196px;
    }
  }
  /* L'ultima sezione occupa quanto basta perché, cliccata nella riga, arrivi anche lei sotto la riga (80 px). */
  /* In scuro il titolo usa il colore "on" del progetto: il primary di PedagogicPoint sparirebbe sullo sfondo. */
  main {
    --lettering: light-dark(var(--primary), var(--on-primary));
    --lettering-sotto: var(--fondo);
  }
  .coda {
    min-height: calc(100svh - 80px - var(--page-gap) - var(--prossimo-h) - var(--page-bottom));
  }
  .prossimo .freccia {
    transition: transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .prossimo:hover .freccia {
      transform: translateX(4px);
    }
  }
  .prossimo:focus-visible .freccia {
    transform: translateX(4px);
  }
</style>
